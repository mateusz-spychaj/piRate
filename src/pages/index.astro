---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import SocialProof from '../components/landing/SocialProof.astro';
import StatsSection from '../components/landing/StatsSection.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import ScoringDimensions from '../components/landing/ScoringDimensions.astro';
import DemoPreview from '../components/landing/DemoPreview.astro';
import Footer from '../components/landing/Footer.astro';
import { t } from '../i18n';

const lang = (Astro.locals as any).lang ?? 'pl';
---

<Layout title={t('meta.title', lang)} description={t('meta.description', lang)}>
  <main id="main-content">
    <Hero lang={lang} />
    <SocialProof lang={lang} />
    <StatsSection lang={lang} />
    <HowItWorks lang={lang} />
    <ScoringDimensions lang={lang} />
    <DemoPreview lang={lang} />
    <Footer lang={lang} />
  </main>
</Layout>

---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
}

const testimonials: Testimonial[] = [
  {
    quote: 'piRate totalnie zmienił sposób w jaki nasz team reviewuje PRy. AI dostarcza obiektywnych metryk do daily discussion. Jakość kodu wzrosła o 40% w 3 miesiące.',
    name: 'Marcus Chen',
    role: 'Senior Developer',
    company: 'TechFlow',
  },
  {
    quote: 'Byłem sceptyczny, ale po przepuszczeniu 50 PRów przez piRate wnioski otworzyły mi oczy. Sam AI Leverage score pomógł nam znaleźć obszary do automatyzacji.',
    name: 'Sarah Okafor',
    role: 'Engineering Manager',
    company: 'DataBridge',
  },
  {
    quote: 'W końcu narzędzie które mówi językiem zarówno devów jak i managerów. Podsumowanie pirackie to nasza nowa ulubiona integracja Slackowa.',
    name: 'Alex Rivera',
    role: 'CTO',
    company: 'ScaleUp Labs',
  },
];
---

<section class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-12">
      <p class="text-sm text-text-muted uppercase tracking-wider mb-3">
        Zaufali nam
      </p>
      <h2 class="text-3xl font-bold text-text-primary">
        Co mówią użytkownicy
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <article class="rounded-xl bg-gray-900 p-6 text-white shadow-lg flex flex-col">
          <div class="flex gap-1 mb-4" aria-label="5 na 5 gwiazdek">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 fill-amber-400" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <blockquote class="text-sm leading-relaxed text-gray-200 mb-6 flex-1">
            &ldquo;{t.quote}&rdquo;
          </blockquote>

          <footer class="border-t border-gray-700 pt-4">
            <div class="font-semibold text-sm">{t.name}</div>
            <div class="text-xs text-gray-400">
              {t.role} · {t.company}
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;

const logos = [
  { name: 'TechCrunch', url: 'https://techcrunch.com' },
  { name: 'The Verge', url: 'https://theverge.com' },
  { name: 'WIRED', url: 'https://wired.com' },
  { name: 'GitHub', url: 'https://github.com' },
  { name: 'Dev.to', url: 'https://dev.to' },
  { name: 'Hacker News', url: 'https://news.ycombinator.com' },
];

function faviconUrl(url: string) {
  return `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=${url}&size=64`;
}
---

<section class="section overflow-hidden">
  <div class="container-custom">
    <div class="text-center mb-12 animate-on-scroll">
      <p class="text-sm text-text-muted uppercase tracking-wider mb-3">
        {t('socialProof.asSeenIn', l)}
      </p>
    </div>
  </div>

  <div class="carousel-container mb-6">
    <div class="carousel-track">
      {[...logos, ...logos].map((logo) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-xl bg-surface dark:bg-gray-800 border border-border transition-all duration-300 hover:border-primary hover:shadow-md cursor-pointer group shrink-0">
          <img
              src={faviconUrl(logo.url)}
              alt=""
              width="40"
              height="40"
              class="w-10 h-10 rounded-lg"
              loading="lazy"
            />
          <span class="text-sm font-semibold text-text-muted group-hover:text-text-primary transition-colors whitespace-nowrap">
            {logo.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

---
const logos = [
  { name: 'TechCrunch', initials: 'TC' },
  { name: 'HackerNews', initials: 'HN' },
  { name: 'GitHub', initials: 'GH' },
  { name: 'Vercel', initials: 'VC' },
  { name: 'Dev.to', initials: 'DV' },
];
---

<section class="py-12 border-y border-border bg-surface/50">
  <div class="container-custom">
    <p class="text-center text-sm text-text-muted uppercase tracking-wider mb-8">
      Narzędzie, któremu ufają zespoły dev
    </p>

    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
      {logos.map((logo) => (
        <div class="flex items-center gap-2 text-text-muted/60 hover:text-text-muted transition-colors" aria-label={logo.name}>
          <span class="text-2xl font-bold tracking-tight">{logo.initials}</span>
        </div>
      ))}
    </div>
  </div>
</section>

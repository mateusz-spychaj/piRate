---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;

const logos = [
  { name: 'TechCrunch', bg: 'from-orange-500 to-red-500', initial: 'T' },
  { name: 'The Verge', bg: 'from-blue-600 to-blue-800', initial: 'V' },
  { name: 'WIRED', bg: 'from-red-600 to-red-800', initial: 'W' },
  { name: 'GitHub', bg: 'from-gray-700 to-gray-900', initial: 'GH' },
  { name: 'Dev.to', bg: 'from-gray-600 to-gray-800', initial: 'D' },
  { name: 'Hacker News', bg: 'from-orange-600 to-orange-700', initial: 'HN' },
];
---

<section class="section overflow-hidden">
  <div class="container-custom">
    <div class="text-center mb-12 animate-on-scroll">
      <p class="text-sm text-text-muted uppercase tracking-wider mb-3">
        {t('socialProof.asSeenIn', l)}
      </p>
    </div>
  </div>

  <div class="carousel-container mb-6">
    <div class="carousel-track">
      {[...logos, ...logos].map((logo) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-xl bg-surface dark:bg-gray-800 border border-border transition-all duration-300 hover:border-primary hover:shadow-md cursor-pointer group">
          <div class={`w-10 h-10 rounded-lg bg-gradient-to-br ${logo.bg} flex items-center justify-center text-white font-bold text-xs`}>
            {logo.initial}
          </div>
          <span class="text-sm font-semibold text-text-muted group-hover:text-text-primary transition-colors">
            {logo.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

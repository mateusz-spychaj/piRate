---
---

<section class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        Przykładowy wynik
      </h2>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto">
        Tak wygląda dashboard po analizie repozytorium
      </p>
    </div>

    <div class="max-w-4xl mx-auto card border-2 border-border shadow-lg overflow-hidden animate-slide-up">
      <div class="bg-surface px-6 py-4 border-b border-border flex items-center gap-2">
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-full bg-danger/60"></div>
          <div class="w-3 h-3 rounded-full bg-warning/60"></div>
          <div class="w-3 h-3 rounded-full bg-accent/60"></div>
        </div>
        <span class="text-sm text-text-muted ml-4">piRate Dashboard</span>
      </div>

      <div class="p-6 md:p-8">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="flex-1 text-center">
            <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-gradient-to-br from-primary to-accent text-white text-5xl font-bold mb-4">
              78
            </div>
            <p class="text-sm text-text-muted">Wynik całkowity</p>
          </div>

          <div class="flex-1 space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-text-secondary">Wpływ</span>
                <span class="font-semibold text-accent">82</span>
              </div>
              <div class="h-2 bg-surface rounded-full overflow-hidden">
                <div class="h-full bg-accent rounded-full" style="width: 82%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-text-secondary">Wykorzystanie AI</span>
                <span class="font-semibold text-primary">71</span>
              </div>
              <div class="h-2 bg-surface rounded-full overflow-hidden">
                <div class="h-full bg-primary rounded-full" style="width: 71%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-text-secondary">Jakość</span>
                <span class="font-semibold text-warning">80</span>
              </div>
              <div class="h-2 bg-surface rounded-full overflow-hidden">
                <div class="h-full bg-warning rounded-full" style="width: 80%"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-border">
          <div class="flex items-center gap-3 p-4 bg-pirate/5 rounded-lg border border-pirate/20">
            <span class="text-2xl">🏴‍☠️</span>
            <p class="text-sm text-pirate italic">
              "Arrr, this repo be a treasure trove! 5 PRs analyzed, all shining like gold doubloons!"
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;
---

<section class="section">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        {t('demo.title', l)}
      </h2>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto">
        {t('demo.subtitle', l)}
      </p>
    </div>

    <div class="max-w-4xl mx-auto card border-2 border-border shadow-lg overflow-hidden animate-slide-up">
      <div class="bg-surface dark:bg-gray-800 px-6 py-4 border-b border-border flex items-center gap-2">
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-full bg-danger/60"></div>
          <div class="w-3 h-3 rounded-full bg-warning/60"></div>
          <div class="w-3 h-3 rounded-full bg-accent/60"></div>
        </div>
        <span class="text-sm text-text-muted ml-4">πRate Dashboard</span>
      </div>

      <div class="p-6 md:p-8">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="flex-1 text-center">
            <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-gradient-to-br from-primary to-accent text-white text-5xl font-bold mb-4">
              78
            </div>
            <p class="text-sm text-text-muted">{t('dashboard.totalScore', l)}</p>
          </div>

          <div class="flex-1 space-y-4">
            {[
              { label: t('dimensions.impact', l), value: 82, color: 'var(--color-accent)' },
              { label: t('dimensions.aiLeverage', l), value: 71, color: 'var(--color-primary)' },
              { label: t('dimensions.quality', l), value: 80, color: 'var(--color-warning)' },
            ].map((dim) => (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="text-text-secondary">{dim.label}</span>
                  <span class="font-semibold" style={{ color: dim.color }}>{dim.value}</span>
                </div>
                <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                  <div class="h-full rounded-full" style={{ width: `${dim.value}%`, backgroundColor: dim.color }}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-border">
          <div class="flex items-center gap-3 p-4 bg-amber-50 dark:bg-amber-900/20 rounded-lg border border-amber-200 dark:border-amber-800">
            <span class="text-amber-600 dark:text-amber-400 text-lg font-bold">⚓</span>
            <p class="text-sm text-amber-800 dark:text-amber-200 italic">
              "Arrr, this repo be a treasure trove! 5 PRs analyzed, all shining like gold doubloons!"
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import RepoInput from '../islands/RepoInput';
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;
---

<section class="relative overflow-hidden bg-gradient-to-b from-surface to-white dark:to-gray-900 py-20 md:py-32">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto animate-fade-in">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-text-primary tracking-tight leading-tight">
        {t('hero.title', l)}
      </h1>

      <p class="mt-6 text-lg md:text-xl text-text-secondary max-w-2xl mx-auto">
        {t('hero.subtitle', l)}
      </p>

      <div class="mt-10 max-w-xl mx-auto">
        <RepoInput client:load lang={lang} />
      </div>
    </div>
  </div>

  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
  </div>
</section>

---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;

const steps = [
  { step: 1, titleKey: 'howItWorks.step1.title', descKey: 'howItWorks.step1.description' },
  { step: 2, titleKey: 'howItWorks.step2.title', descKey: 'howItWorks.step2.description' },
  { step: 3, titleKey: 'howItWorks.step3.title', descKey: 'howItWorks.step3.description' },
];
---

<section class="section">
  <div class="container-custom">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary mb-16">
      {t('howItWorks.title', l)}
    </h2>

    <div class="grid md:grid-cols-3 gap-8 md:gap-12">
      {steps.map((s) => (
        <div class="relative text-center">
          <div class="inline-flex items-center justify-center w-24 h-24 rounded-2xl bg-primary/10 text-primary dark:text-primary-dark mb-6 text-2xl font-bold">
            0{s.step}
          </div>

          <div class="absolute -top-2 right-0 md:left-1/2 md:-translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white text-sm font-bold flex items-center justify-center">
            {s.step}
          </div>

          <h3 class="text-xl font-semibold text-text-primary mb-3">
            {t(s.titleKey, l)}
          </h3>

          <p class="text-text-secondary">
            {t(s.descKey, l)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
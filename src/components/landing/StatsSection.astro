---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;

const stats = [
  { value: '10K+', key: 'stats.prsAnalyzed' },
  { value: '99.7%', key: 'stats.accuracy' },
  { value: '4.9/5', key: 'stats.rating' },
  { value: '50+', key: 'stats.integrations' },
];
---

<section class="section bg-gradient-to-b from-surface to-white dark:from-gray-900 dark:to-gray-900">
  <div class="container-custom">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((s, i) => (
        <div
          class="text-center animate-on-scroll"
          class:list={{ 'stagger-1': i === 0, 'stagger-2': i === 1, 'stagger-3': i === 2, 'stagger-4': i === 3 }}
        >
          <div class="text-4xl md:text-5xl font-extrabold text-primary mb-2">
            {s.value}
          </div>
          <p class="text-sm text-text-muted uppercase tracking-wider">
            {t(s.key, l)}
          </p>
        </div>
      ))}
    </div>
  </div>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.animate-on-scroll').forEach((el) => {
      observer.observe(el);
    });
  </script>
</section>

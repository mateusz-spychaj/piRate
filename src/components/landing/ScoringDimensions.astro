---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;

const dimensions = [
  { iconKey: 'dimensions.impact', descKey: 'dimensions.impact.description', color: 'text-accent', bgColor: 'bg-accent/10' },
  { iconKey: 'dimensions.aiLeverage', descKey: 'dimensions.aiLeverage.description', color: 'text-primary', bgColor: 'bg-primary/10' },
  { iconKey: 'dimensions.quality', descKey: 'dimensions.quality.description', color: 'text-warning', bgColor: 'bg-warning/10' },
  { iconKey: 'dimensions.pirateSummary', descKey: 'dimensions.pirateSummary.description', color: 'text-pirate', bgColor: 'bg-pirate/10' },
];
---

<section class="section bg-surface">
  <div class="container-custom">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary mb-16">
      {t('dimensions.title', l)}
    </h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {dimensions.map((dim) => (
        <div class="card hover:shadow-md transition-shadow duration-300 group cursor-pointer">
          <div class={`inline-flex items-center justify-center w-14 h-14 rounded-xl ${dim.bgColor} ${dim.color} mb-4 group-hover:scale-110 transition-transform duration-300 text-2xl font-bold`}>
            {t(dim.iconKey, l).charAt(0)}
          </div>

          <h3 class="text-lg font-semibold text-text-primary mb-2">
            {t(dim.iconKey, l)}
          </h3>

          <p class="text-sm text-text-secondary">
            {t(dim.descKey, l)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
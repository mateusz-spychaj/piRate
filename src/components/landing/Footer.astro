---
import { t } from '../../i18n';
import type { Language } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Language;
---

<footer class="bg-text-primary dark:bg-gray-950 text-white py-12">
  <div class="container-custom">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-xl font-bold mb-3">πRate</h3>
        <p class="text-white/60 text-sm">
          {t('footer.description', l)}
        </p>
      </div>

      <div>
        <h4 class="font-semibold mb-3">{t('footer.links', l)}</h4>
        <ul class="space-y-2">
          {[
            { key: 'footer.documentation', href: '#' },
            { key: 'footer.api', href: '#' },
            { key: 'footer.github', href: 'https://github.com/mateusz-spychaj/piRate' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors">
                {t(link.key, l)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-3">{t('footer.legal', l)}</h4>
        <ul class="space-y-2">
          {[
            { key: 'footer.privacy', href: '#' },
            { key: 'footer.terms', href: '#' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors">
                {t(link.key, l)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 text-center text-sm text-white/60">
      {t('footer.copyright', l)}
    </div>
  </div>
</footer>
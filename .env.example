# Required for real AI analysis (without it, mock scores are used)
OPENROUTER_API_KEY=

# Optional: GitHub token for higher API rate limits (5000 req/h instead of 60)
GITHUB_TOKEN=

# Optional: OpenRouter model override (default: meta-llama/llama-3.1-8b-instruct)
LLM_MODEL=

# Optional: Site URL for OpenRouter HTTP-Referer header
SITE_URL=https://pir-rate.vercel.app
